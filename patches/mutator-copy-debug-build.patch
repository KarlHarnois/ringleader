+def _copy_debug_build(worker: Path, root: Path) -> None:
+    """Cargo reuses every dependency in the copy and rebuilds only the mutated crate.
+
+    copytree keeps modification times, which Cargo compares to find stale units.
+    """
+
+    debug_build = root / "target" / "debug"
+    if debug_build.is_dir():
+        shutil.copytree(debug_build, worker / "target" / "debug", symlinks=True)
+
