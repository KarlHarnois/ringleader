+def _copy_debug_build(worker: Path, root: Path) -> None:
+    """Cargo reuses every dependency in the copy and rebuilds only the mutated crate.
+
+    copytree keeps modification times, which Cargo compares to find stale units.
+    rustc ignores an incremental cache built in another directory, so the copy
+    leaves it out.
+    """
+
+    debug_build = root / "target" / "debug"
+    if debug_build.is_dir():
+        shutil.copytree(
+            debug_build,
+            worker / "target" / "debug",
+            symlinks=True,
+            ignore=_skip_incremental_cache(debug_build),
+        )
+
+
+def _skip_incremental_cache(debug_build: Path):
+    def ignored(directory: str, _names: list[str]) -> list[str]:
+        return ["incremental"] if Path(directory) == debug_build else []
+
+    return ignored
+
+
